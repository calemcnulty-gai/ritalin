# Exclude large electron files and unnecessary content
electron-game-window/node_modules/**
electron-game-window/dist/**
electron-game-window/*.app/**
node_modules/electron/**
venv/**

# Development files
.vscode/**
.git
.gitignore

# Documentation and development files  
docs/**
*.md
!README.md
!EXTENSION_README.md

# Test files
test-*.js
chat-detection-*.js
src/test/**
*.test.ts
*.spec.ts

# TypeScript source files (only include compiled .js)
src/**/*.ts
!src/**/*.js
tsconfig.json

# Development dependencies
.cursor/changelog.md
.cursor/project_plan.md
.cursor/rules/**
.cursor/is_working
brainlift.md
example_brainlift.md
global_cursor_rules.md
PRD.md

# Python cache files
scripts/__pycache__/**
*.pyc

# Build artifacts
out/test/**
*.map

# Only include essential files for the extension to work 