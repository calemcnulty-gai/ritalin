{
  "name": "ritalin",
  "displayName": "Ritalin for Cursor",
  "description": "Mini-games during AI generation for focus",
  "version": "0.2.0",
  "publisher": "CaleMcNulty",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritalin-dev/ritalin.git"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "ai",
    "productivity",
    "games",
    "focus",
    "mini-games",
    "ai-coding"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/Alpha-v0.2.0-yellow",
      "href": "https://github.com/ritalin-dev/ritalin/releases",
      "description": "Alpha Release"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ritalin.manageGames",
        "title": "Ritalin: Manage Downloaded Games"
      },
      {
        "command": "ritalin.showConfig",
        "title": "Ritalin: Show Configuration Page"
      },
      {
        "command": "ritalin.togglePause",
        "title": "Ritalin: Pause/Unpause Extension"
      }
    ],
    "viewsContainers": {},
    "views": {},
    "configuration": {
      "title": "Ritalin",
      "properties": {
        "ritalin.externalWindow.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the external game window instead of the panel."
        },
        "ritalin.externalWindow.position": {
          "type": "string",
          "default": "bottom-right",
          "enum": [
            "bottom-left",
            "bottom-right",
            "top-left",
            "top-right",
            "center",
            "overlay",
            "custom"
          ],
          "description": "Position of the external game window."
        },
        "ritalin.externalWindow.customX": {
          "type": "number",
          "default": 0,
          "description": "Custom X position for the window."
        },
        "ritalin.externalWindow.customY": {
          "type": "number",
          "default": 0,
          "description": "Custom Y position for the window."
        },
        "ritalin.externalWindow.width": {
          "type": "number",
          "description": "Width of the external game window."
        },
        "ritalin.externalWindow.height": {
          "type": "number",
          "description": "Height of the external game window."
        },
        "ritalin.externalWindow.monitor": {
          "type": "string",
          "default": "primary",
          "enum": [
            "primary",
            "secondary",
            "auto"
          ],
          "description": "Which monitor to display the window on."
        },
        "ritalin.externalWindow.alwaysOnTop": {
          "type": "boolean",
          "default": true,
          "description": "Keep the game window always on top."
        },
        "ritalin.externalWindow.hideOnBlur": {
          "type": "boolean",
          "default": false,
          "description": "Hide the game window when it loses focus."
        },
        "ritalin.selectedGame": {
          "type": "string",
          "default": null,
          "description": "ID of the currently selected game."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run version:build && vsce package --out builds/",
    "package:alpha": "npm run version:build && vsce package --pre-release --out builds/",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:build": "node scripts/increment-build.js",
    "version:bump": "node scripts/version-manager.js bump",
    "version:prepare-release": "node scripts/version-manager.js prepare-release",
    "version:info": "node scripts/version-manager.js info",
    "release:alpha": "npm run version:bump patch -- --pre-release && npm run package:alpha",
    "release:patch": "npm run version:bump patch && npm run package",
    "release:minor": "npm run version:bump minor && npm run package",
    "release:major": "npm run version:bump major && npm run package",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "electron": "^27.0.0",
    "eslint": "^8.26.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "buildMetadata": {
    "buildNumber": 9,
    "timestamp": "2025-07-01T17:29:28.653Z"
  }
}
